PORT=3001
# Comma-separated optional; localhost + 127.0.0.1 are always allowed in dev
FRONTEND_ORIGIN=http://localhost:3000

MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_BASE_URL=https://api.minimax.io

# Optional — when set, switches embeddings from hash-based to OpenAI text-embedding-3-small.
# Recommended for production: improves RAG retrieval quality significantly.
OPENAI_API_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
